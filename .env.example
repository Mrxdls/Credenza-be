# ==============================================================================
# Credenza Backend - Environment Configuration Template (.env.example)
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-key-here
ALLOWED_HOSTS=*

# CORS & CSRF
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-backend.vercel.app,https://*.vercel.app,https://*.trycloudflare.com

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require
DB_ENGINE=postgresql
DB_NAME=poornima_achievements
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require
CONN_MAX_AGE=0

# Storage Engine (Cloudflare R2 or AWS S3)
STORAGE_BACKEND=r2

# Cloudflare Infrastructure
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_BUCKET=poornima-achievements-r2
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_PUBLIC_DOMAIN=
PUBLIC_MEDIA_URL=https://your-backend.vercel.app/media/

CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_D1_API_TOKEN=your_cloudflare_api_token

# AWS S3 (Alternative)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PRESIGNED_EXPIRY=3600

# Email & SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@poornima.edu
SERVER_EMAIL=noreply@poornima.edu

